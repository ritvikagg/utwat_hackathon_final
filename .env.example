STEEL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Set to "local" to drive the agent with a local LM Studio model instead of
# the Anthropic API. Anything else (or unset) uses Anthropic.
LLM_PROVIDER=anthropic
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# The exact model identifier LM Studio's server expects — check the
# "Local Server" tab in LM Studio while your model is loaded.
LOCAL_LLM_MODEL=local-model

# --- Shared hub (multi-teammate mode) ---
# Port the hub server listens on (only used when running `npm run hub`).
HUB_PORT=4001
# Leave blank to use the local data/playbooks.json + data/runs.json files
# (solo mode, and what the hub itself always uses). Teammates set this to
# the hub's address (e.g. http://<hub-host>:4001) to share one library.
HIVEMIND_HUB_URL=
# Required when HIVEMIND_HUB_URL is set — the hub now has accounts, so the
# CLI needs to authenticate too. Sign up / log in at the hub's dashboard URL
# in a browser, then copy the token shown there (top-right, "Your API
# token") into this value.
HIVEMIND_API_TOKEN=
# Shown in the shared activity feed. Defaults to your OS username if unset.
HIVEMIND_AGENT_NAME=
